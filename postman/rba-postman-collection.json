			"name": "Exchange Calculator API",
			"item": [
				{
					"name": "Buy GBP",
					"item": [
						{
							"name": "Open Exchange Calculator",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseURL}}{{exchangeCalculatorPath}}",
									"host": [
										"{{baseURL}}{{exchangeCalculatorPath}}"
									]
								}
							},
							"response": []
						},
						{
							"name": "Buy GBP",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code is 200\", function () {\r",
											"    pm.response.to.have.status(200);\r",
											"});\r",
											"\r",
											"pm.test(\"Response time is under 5 seconds\", function () {\r",
											"    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
											"});\r",
											"\r",
											"const json = pm.response.json();\r",
											"pm.expect(json.form).to.exist;\r",
											"\r",
											"\r",
											"const exchangeRate = json.form.exchangeRate;\r",
											"const effectiveRate = json.form.effectiveRate;\r",
											"const moneyAmount = json.form.currency1Ammount;\r",
											"const returnedExchangeAmount = json.form.currency2Ammount;\r",
											"const returnedEffectiveAmount = json.form.currency2AmmountEfe;\r",
											"\r",
											"pm.test(\"Exchange rate present\", function () {\r",
											"    pm.expect(exchangeRate).to.not.be.null;\r",
											"});\r",
											"\r",
											"pm.test(\"Calculated result is correct\", function () {\r",
											"    const expectedExchangeAmount = (moneyAmount * exchangeRate);\r",
											"    const expectedEffectiveAmount = (moneyAmount * effectiveRate);\r",
											"\r",
											"    const expectedExchangeAmountRounded = Number(expectedExchangeAmount.toFixed(8));\r",
											"    const expectedEffectiveAmountRounded = Number(expectedEffectiveAmount.toFixed(8));\r",
											"\r",
											"    pm.expect(Number(returnedExchangeAmount)).to.eql(expectedExchangeAmountRounded);\r",
											"    pm.expect(Number(returnedEffectiveAmount)).to.eql(expectedEffectiveAmountRounded);\r",
											"});\r",
											""
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								},
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const min = 10;\r",
											"const max = 1000;\r",
											"\r",
											"let value = Math.random() * (max - min) + min;\r",
											"\r",
											"value = Number(value.toFixed(2));\r",
											"\r",
											"pm.environment.set(\"randomAmount\", value);\r",
											""
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "urlencoded",
									"urlencoded": [
