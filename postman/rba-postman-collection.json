			"name": "Wikipedia Search API",
			"item": [
				{
					"name": "Raiffeisen Wiki Search",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let json = pm.response.json();\r",
									"\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Response time is under 5 seconds\", function () {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
									"});\r",
									"\r",
									"pm.test(\"Response contains 'pages'\", function () {\r",
									"    pm.expect(json.query).to.have.property(\"pages\");\r",
									"});\r",
									"\r",
									"pm.test(\"One result has title 'Raiffeisen Bank International'\", function () {\r",
									"    const pages = Object.values(json.query.pages);\r",
									"    const hasTitle = pages.some(p => p.title === \"Raiffeisen Bank International\");\r",
									"    pm.expect(hasTitle).to.be.true;\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{wikiBaseURL}}?action=query&generator=search&gsrsearch=Raiffeisen&gsrlimit=10&prop=info&format=json&utf8=1",
